---
import Header from "../components/Header.astro";
import Main from "../components/Main.astro";
import Footer from "../components/Footer.astro";
import "../styles/style.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/fav-icon.png"
    />
    <title>Amir</title>
  </head>
  <body>
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 h-[4px] bg-gradient-to-br from-[#8a2be2] via-[#da70d6] to-[#4b0082] w-0 z-50 transition-all duration-75"
    >
    </div>
    <Header client:load />
    <Main client:load />
    <Footer client:load />
    <script
      src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"
    ></script>
    <script src="https://unpkg.com/scrollreveal" type="module"></script>
    <script type="module">
      const progressBar = document.getElementById("scroll-progress");
      window.addEventListener("scroll", () => {
        const scrollTop = window.scrollY;
        const docHeight =
          document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = (scrollTop / docHeight) * 100;
        progressBar.style.width = scrollPercent + "%";
      });
      ScrollReveal().reveal(".p-presentation, .my-other-class", {
        duration: 1000,
        origin: "right",
        distance: "20px",
        easing: "ease-in-out",
        reset: false,
      });
    </script>
  </body>
</html>
