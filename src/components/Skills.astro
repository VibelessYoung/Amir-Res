---
import "../styles/style.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <main class="p-5 bg-[#181C23]">
      <section class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold mb-6 text-center text-white">
          مهارت‌ها
        </h2>
        <div class="space-y-4">
          <div class="skill-item">
            <div class="flex justify-between items-center mb-1">
              <span class="font-medium text-white">HTML</span>
              <span class="text-sm font-medium text-white">80%</span>
            </div>
            <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
              <div
                class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="90"
                data-value="90"
                style="background: linear-gradient(to right, #22c55e, #4ade80, #86efac); width: 80%; transform: scaleX(0);"
              >
              </div>
            </div>
          </div>
          <div class="skill-item">
            <div class="flex justify-between items-center mb-1">
              <span class="font-medium text-white">CSS</span>
              <span class="text-sm font-medium text-white">70%</span>
            </div>
            <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
              <div
                class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="82"
                data-value="82"
                style="background: linear-gradient(to right, #22c55e, #4ade80, #86efac); width: 70%; transform: scaleX(0);"
              >
              </div>
            </div>
          </div>
          <div class="skill-item">
            <div class="flex justify-between items-center mb-1">
              <span class="font-medium text-white">SASS</span>
              <span class="text-sm font-medium text-white">50%</span>
            </div>
            <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
              <div
                class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="82"
                data-value="82"
                style="background: linear-gradient(to right, #eab308, #facc15, #fde047); width: 50%; transform: scaleX(0);"
              >
              </div>
            </div>
          </div>
          <div class="skill-item">
            <div class="flex justify-between items-center mb-1">
              <span class="font-medium text-white">JavaScript</span>
              <span class="text-sm font-medium text-white">40%</span>
            </div>
            <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
              <div
                class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="82"
                data-value="82"
                style="background: linear-gradient(to right, #f97316, #fb923c, #fdba74); width: 40%; transform: scaleX(0);"
              >
              </div>
            </div>
          </div>
          <div class="skill-item">
            <div class="flex justify-between items-center mb-1">
              <span class="font-medium text-white">Tailwind</span>
              <span class="text-sm font-medium text-white">50%</span>
            </div>
            <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
              <div
                class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="76"
                data-value="76"
                style="background: linear-gradient(to right, #eab308, #facc15, #fde047); width: 50%; transform: scaleX(0);"
              >
              </div>
            </div>
          </div>
          <div class="skill-item">
            <div class="flex justify-between items-center mb-1">
              <span class="font-medium text-white">Bootstrap</span>
              <span class="text-sm font-medium text-white">70%</span>
            </div>
            <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
              <div
                class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="76"
                data-value="76"
                style="background: linear-gradient(90deg,#34d399,#10b981); width: 70%; transform: scaleX(0);"
              >
              </div>
            </div>
          </div>
          <div class="skill-item">
            <div class="flex justify-between items-center mb-1">
              <span class="font-medium text-white">React</span>
              <span class="text-sm font-medium text-white">5%</span>
            </div>
            <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
              <div
                class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="76"
                data-value="76"
                style="background: linear-gradient(to right, #ef4444, #f87171, #fca5a5); width: 5%; transform: scaleX(0);"
              >
              </div>
            </div>
          </div>
          <div class="skill-item">
            <div class="flex justify-between items-center mb-1">
              <span class="font-medium text-white">Git / GitHub</span>
              <span class="text-sm font-medium text-white">25%</span>
            </div>
            <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
              <div
                class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="76"
                data-value="76"
                style="background: linear-gradient(to right, #ef4444, #f87171, #fca5a5); width: 25%; transform: scaleX(0);"
              >
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const bars = document.querySelectorAll('[role="progressbar"]');

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const el = entry.target;
              if (entry.isIntersecting) {
                el.style.transform = "scaleX(1)";
              } else {
                el.style.transform = "scaleX(0)";
              }
            });
          },
          { threshold: 0.3 }
        );

        bars.forEach((b) => {
          b.style.transformOrigin = "left";
          b.style.transform = "scaleX(0)";
          b.style.transition = "transform 1s ease-out";
          io.observe(b);
        });
      });
    </script>
  </body>
</html>
