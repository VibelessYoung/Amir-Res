---
import "../styles/style.css";
---

<section
  id="skills"
  class="relative z-10 py-30 bg-[#0A111A] flex flex-col items-center justify-center border-4"
>
  <div
    class="absolute left-0 top-[1px] w-full h-full bg-gradient-to-t from-[#FF6A3D] to-[#0A111A] z-0"
  >
  </div>
  <div
    class="absolute left-0 top-0 w-full h-full bg-black/10 backdrop-blur-[2px] z-0"
  >
  </div>
  <h2
    class="relative text-4xl font-black mb-6 text-white self-end pr-30 after:content-[''] after:absolute after:right-0 after:top-1/2 after:-translate-y-1/2 after:w-24 after:h-[3px] after:bg-[#FF9A3D]"
  >
    مهارت‌ها
  </h2>
  <div
    class="box bg-white/10 backdrop-blur-xl p-20 w-full max-w-[900px] mx-5 rounded-xl transition-all duration-300 shadow-lg hover:-translate-y-3 border border-white/50"
  >
    <section class="max-w-3xl mx-auto">
      <div class="space-y-4">
        <div class="skill-item">
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-white">HTML</span>
            <span class="text-sm font-medium text-white">80%</span>
          </div>
          <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="90"
              data-value="90"
              style="background: linear-gradient(to right, #22c55e, #4ade80, #86efac); width: 80%; transform: scaleX(0);"
            >
            </div>
          </div>
        </div>
        <div class="skill-item">
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-white">CSS</span>
            <span class="text-sm font-medium text-white">70%</span>
          </div>
          <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="82"
              data-value="82"
              style="background: linear-gradient(to right, #22c55e, #4ade80, #86efac); width: 70%; transform: scaleX(0);"
            >
            </div>
          </div>
        </div>
        <div class="skill-item">
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-white">SASS</span>
            <span class="text-sm font-medium text-white">50%</span>
          </div>
          <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="82"
              data-value="82"
              style="background: linear-gradient(to right, #eab308, #facc15, #fde047); width: 50%; transform: scaleX(0);"
            >
            </div>
          </div>
        </div>
        <div class="skill-item">
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-white">JavaScript</span>
            <span class="text-sm font-medium text-white">50%</span>
          </div>
          <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="82"
              data-value="82"
              style="background: linear-gradient(to right, #eab308, #facc15, #fde047); width: 50%; transform: scaleX(0);"
            >
            </div>
          </div>
        </div>
        <div class="skill-item">
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-white">Tailwind</span>
            <span class="text-sm font-medium text-white">60%</span>
          </div>
          <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="76"
              data-value="76"
              style="background: linear-gradient(to right, #22c55e, #4ade80, #86efac); width: 60%; transform: scaleX(0);"
            >
            </div>
          </div>
        </div>
        <div class="skill-item">
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-white">Bootstrap</span>
            <span class="text-sm font-medium text-white">70%</span>
          </div>
          <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="76"
              data-value="76"
              style="background: linear-gradient(90deg,#34d399,#10b981); width: 70%; transform: scaleX(0);"
            >
            </div>
          </div>
        </div>
        <div class="skill-item">
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-white">React</span>
            <span class="text-sm font-medium text-white">5%</span>
          </div>
          <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="76"
              data-value="76"
              style="background: linear-gradient(to right, #ef4444, #f87171, #fca5a5); width: 5%; transform: scaleX(0);"
            >
            </div>
          </div>
        </div>
        <div class="skill-item">
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-white">Astro</span>
            <span class="text-sm font-medium text-white">25%</span>
          </div>
          <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="76"
              data-value="76"
              style="background: linear-gradient(to right, #ef4444, #f87171, #fca5a5); width: 25%; transform: scaleX(0);"
            >
            </div>
          </div>
        </div>
        <div class="skill-item">
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-white">Git / GitHub</span>
            <span class="text-sm font-medium text-white">40%</span>
          </div>
          <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full origin-left transition-transform duration-900 ease-out"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="76"
              data-value="76"
              style="background: linear-gradient(to right, #f97316, #fb923c, #fdba74); width: 40%; transform: scaleX(0);"
            >
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</section>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    ScrollReveal().reveal(".box", {
      duration: 1000,
      origin: "bottom",
      distance: "40px",
      easing: "ease-in-out",
      reset: false,
    });
  });
</script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const bars = document.querySelectorAll('[role="progressbar"]');

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const el = entry.target;
          if (entry.isIntersecting) {
            el.style.transform = "scaleX(1)";
          } else {
            el.style.transform = "scaleX(0)";
          }
        });
      },
      { threshold: 0.3 },
    );

    bars.forEach((b) => {
      b.style.transformOrigin = "left";
      b.style.transform = "scaleX(0)";
      b.style.transition = "transform 1s ease-out";
      io.observe(b);
    });
  });
</script>
