---
import "../styles/style.css";
---

<section
  id="skills"
  class="relative z-10 py-30 bg-[#0A111A] flex flex-col items-center justify-center"
>
  <div
    class="absolute left-0 top-[1px] w-full h-full bg-gradient-to-t from-[#A855F7] to-[#0A111A] z-0"
  >
  </div>
  <div
    class="absolute left-0 top-0 w-full h-full bg-black/10 backdrop-blur-[2px] z-0"
  >
  </div>
  <h2
    class="relative text-4xl font-black mb-10 text-white self-end pr-30
    after:content-[''] after:absolute after:right-0 after:top-1/2 after:-translate-y-1/2
    after:w-24 after:h-[3px] after:bg-[#E9D5FF]"
  >
    مهارت‌ها
  </h2>
  <div
    class="box bg-white/10 backdrop-blur-xl p-20 w-full max-w-[900px] mx-5 rounded-xl
    transition-all duration-300 shadow-lg hover:-translate-y-3 border border-white/50"
  >
    <section class="max-w-3xl mx-auto space-y-6">
      <div class="skill-item">
        <div class="flex justify-between items-center mb-1">
          <span class="font-medium text-white flex items-center gap-2">
            <iconify-icon icon="logos:html-5"></iconify-icon>
            HTML
          </span>
          <span class="text-sm font-medium text-white">80%</span>
        </div>
        <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">
          <div
            class="h-full rounded-full origin-left progress"
            data-value="80"
            style="background: linear-gradient(to right, #16a34a, #22c55e, #4ade80);"
          >
          </div>
        </div>
      </div>
