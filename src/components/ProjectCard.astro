---
const { title, description, image, alt, url } = Astro.props;
---

<div
  class="h-auto flex flex-col gap-4 bg-[#1F242C] rounded-2xl shadow-2xl overflow-hidden group"
>
  <img src={image} alt={alt} loading="lazy" class="w-full h-44 object-cover" />

  <h2 class="text-center text-gray-300 text-2xl font-black mt-3">
    {title}
  </h2>

  <p dir="rtl" class="text-center text-gray-300 text-sm mt-2 px-3">
    {description}
  </p>

  <a href={url} target="_blank">
    <button
      class="cursor-pointer mb-3 flex items-center justify-center gap-2 px-4 py-2 mt-auto mx-auto bg-[#8B5CF6] hover:bg-purple-800 rounded-lg transition"
    >
      مشاهده
    </button>
  </a>
</div>
