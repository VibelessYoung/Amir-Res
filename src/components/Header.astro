---
import "../styles/style.css";
---

<!doctype html>
<html class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <!--         bg-gradient-to-r from-purple-700 via-purple-500 to-purple-700
 -->

  <body>
    <header
      class="relative h-screen flex items-start justify-between px-10 pt-4
         text-white shadow-lg bg-[url('/src/images/header.png')] bg-no-repeat bg-cover bg-center"
    >
      <div class="absolute inset-0 bg-black/40 backdrop-blur-md z-0"></div>

      <!-- Logo / Brand -->
      <div class="relative z-10 flex items-center gap-2">
        <!-- User Icon -->
        <div
          class="flex items-center justify-center w-10 h-10 rounded-full
             bg-white/20"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 
             1.79-4 4 1.79 4 4 4zm0 2c-3.33 0-6 2.67-6 6h12c0-3.33-2.67-6-6-6z"
            ></path>
          </svg>
        </div>
        <strong class="text-2xl font-bold tracking-wide">
          VibelessYoung
        </strong>
      </div>

      <!-- Navbar -->
      <nav class="relative z-10 flex gap-8 text-lg font-medium">
        <a href="#" class="relative group"
          >About
          <span
            class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white group-hover:w-full transition-all duration-300"
          ></span>
        </a>
        <a href="#" class="relative group"
          >Skills
          <span
            class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white group-hover:w-full transition-all duration-300"
          ></span>
        </a>
        <a href="#" class="relative group"
          >Projects
          <span
            class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white group-hover:w-full transition-all duration-300"
          ></span>
        </a>
        <a href="#" class="relative group"
          >Contact
          <span
            class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white group-hover:w-full transition-all duration-300"
          ></span>
        </a>
      </nav>

      <div
        dir="rtl"
        class="absolute inset-0 flex flex-col items-center justify-center z-10 pointer-events-none"
      >
        <h1 class="text-5xl font-semibold">
          <span class="typing-effect"></span>
          <span class="typing-cursor">|</span>
        </h1>
      </div>
    </header>

    <script>
      function createTypingEffect(element, texts, speed = 100) {
        let textIndex = 0;
        let charIndex = 0;
        let isDeleting = false;

        function type() {
          const currentText = texts[textIndex];

          if (isDeleting) {
            element.textContent = currentText.substring(0, charIndex - 1);
            charIndex--;
          } else {
            element.textContent = currentText.substring(0, charIndex + 1);
            charIndex++;
          }

          let typeSpeed = speed;

          if (isDeleting) {
            typeSpeed /= 2;
          }

          if (!isDeleting && charIndex === currentText.length) {
            typeSpeed = 2000;
            isDeleting = true;
          } else if (isDeleting && charIndex === 0) {
            isDeleting = false;
            textIndex = (textIndex + 1) % texts.length; // NEXT TEXT
            typeSpeed = 500; // STOP
          }
          setTimeout(type, typeSpeed);
        }
        type();
      }

      // LOAD EFFECT
      document.addEventListener("DOMContentLoaded", function () {
        const typingElement = document.querySelector(".typing-effect");

        // TEXTS

        if (typingElement) {
          const texts = [" امیر هستم", "طراح سایت", "برنامه‌نویس", "و . . ."];

          //  START TYPE EFFECT
          createTypingEffect(typingElement, texts, 150);
        }
      });
    </script>
  </body>
</html>
