---
import "../styles/style.css";
---

<!doctype html>
<html class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body>
    <header
      class="sticky top-0 z-50 flex items-center justify-between px-10 py-4
        bg-gradient-to-r from-purple-700 via-purple-500 to-purple-700
        text-white shadow-lg"
    >
      <!-- Logo / Brand -->
      <div class="flex items-center gap-2">
        <!-- User Icon -->
        <div
          class="flex items-center justify-center w-10 h-10 rounded-full
                bg-white/20 backdrop-blur-md"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 
                 1.79-4 4 1.79 4 4 4zm0 2c-3.33 0-6 2.67-6 6h12c0-3.33-2.67-6-6-6z"
            ></path>
          </svg>
        </div>
        <strong class="text-2xl font-bold tracking-wide">
          VibelessYoung
        </strong>
      </div>

      <!-- Navbar -->
      <nav class="flex gap-8 text-lg font-medium">
        <a href="#" class="relative group">
          About
          <span
            class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white
                   group-hover:w-full transition-all duration-300"
          ></span>
        </a>

        <a href="#" class="relative group">
          Skills
          <span
            class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white
                   group-hover:w-full transition-all duration-300"
          ></span>
        </a>

        <a href="#" class="relative group">
          Projects
          <span
            class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white
                   group-hover:w-full transition-all duration-300"
          ></span>
        </a>

        <a href="#" class="relative group">
          Contact
          <span
            class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white
                   group-hover:w-full transition-all duration-300"
          ></span>
        </a>
      </nav>
    </header>
  </body>
</html>
