---
// Header.astro
import "../styles/style.css";
import TypingEffect from "./TypingEffect.astro";
import ScrollRevealIcons from "./ScrollRevealIcons.astro";
import MobileMenu from "./MobileMenu.astro";
---

<header
  class="h-screen px-10 pt-4 flex flex-col
         text-white bg-[url('/images/header.png')] bg-no-repeat bg-cover bg-center relative"
>
  <div class="absolute inset-0 bg-black/40 backdrop-blur-md z-0"></div>
  <div class="flex items-start justify-between z-10">
    <div class="flex items-center gap-2">
      <div
        class="flex items-center justify-center w-10 h-10 rounded-full bg-white/20"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6 text-white"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 
             1.79-4 4 1.79 4 4 4zm0 2c-3.33 0-6 2.67-6 6h12c0-3.33-2.67-6-6-6z"
          ></path>
        </svg>
      </div>
      <strong class="text-2xl font-bold tracking-wide">VibelessYoung</strong>
    </div>
    <nav class="hidden md:flex gap-8 text-lg font-medium">
      <a href="#about" class="relative group">
        About
        <span
          class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white group-hover:w-full transition-all duration-300"
        ></span>
      </a>
      <a href="#skills" class="relative group">
        Skills
        <span
          class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white group-hover:w-full transition-all duration-300"
        ></span>
      </a>
      <a href="#projects" class="relative group">
        Projects
        <span
          class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white group-hover:w-full transition-all duration-300"
        ></span>
      </a>
      <a href="#contact" class="relative group">
        Contact
        <span
          class="absolute left-0 -bottom-1 w-0 h-[2px] bg-white group-hover:w-full transition-all duration-300"
        ></span>
      </a>
    </nav>
    <MobileMenu client:load />
  </div>
  <h1
    id="home"
    class="text-[#A855F7] animate-pulse text-7xl sm:text-9xl absolute inset-0 z-10 text-center top-32 font-black"
  >
    Welcome
  </h1>
  <div
    class="absolute inset-0 flex flex-col items-center justify-center z-10 pointer-events-none"
  >
    <h1 class="text-3xl sm:text-6xl font-semibold text-center">
      <TypingEffect client:visible />
    </h1>
  </div>
  <ScrollRevealIcons client:visible />
</header>
