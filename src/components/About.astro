---
import "../styles/style.css";
import PresentationReveal from "./PresentationReveal.astro";
import ProfileImage from "./ProfileImage.astro";
import AboutReveall from "./AboutReveall.astro";
---

<div class="content-presentation" dir="rtl" id="about">
  <div class="linear-gradient-2"></div>
  <div class="linear-gradient-1"></div>
  <div class="container-persentation">
    <div class="container-text">
      <h2 class="text-name">درباره من:</h2>
      <p class="p-presentation" dir="rtl">
        امیرم ، از 16 سالگی با شرکت در کلاس های فنی حرفه ای و اخذ مدرکش وارد
        دنیای برنامه نویسی شدم.<br />
        از 19 سالگی به دلیل علاقه به طراحی سایت وارد حوزه وب شدم.<br />
        و همچنان در حال یادگیری و تلاش و برای فول استک دولوپر شدنم.<br />
        خوشم میاد از افرادی که مثل من فکر میکنن علاقه مندم به شرکت هایی که در کنار
        پول ارزش واقعی ایجاد میکنن.<br />
        خلاصه بگم من شاید یک برنامه نویس حرفه ای نباشم اما جزوی از تماشاگر ها هم
        نیستم همین.        
      </p>
    </div>
    <div class="container-photo-profile">
      <div class="photo-perfil">
        <ProfileImage client:visible />
      </div>
    </div>
  </div>
</div>
<AboutReveall client:visible />
<style>
  .content-presentation {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 600px;
  }
  .linear-gradient-1 {
    position: absolute;
    left: 0;
    top: 0;
    width: 500px;
    height: 520px;
    background: radial-gradient(
      at left center,
      #A855F7,
      transparent,
      transparent
    );
    z-index: 0;
  }
  .linear-gradient-2 {
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      at right center,
      #A855F7,
      #0A111A,
      #0A111A
    );
    z-index: 0;
  }

  .container-persentation {
    position: relative;
    display: flex;
    flex-direction: row;
    padding: 50px 0;
    width: 90%;
    margin: 0 auto;
    max-width: 1355px;
  }
  .container-text {
    position: relative;
    width: 50%;
    color: #f6f6f9;
  }

  .text-hello {
    padding: 10px 0;
    font-size: 20px;
  }

  .text-name {
    padding: 5px 0;
    font-size: 30px;
    color: #ffffff;
    font-weight: 800;
    letter-spacing: 1px;
    margin-top: 30px;
    text-align: center;
    color: #A855F7;
  }

  @keyframes rubberband {
    10% {
      transform: scaleX(1);
    }
    40% {
      transform: scaleX(1.12) scaleY(0.75);
    }
    55% {
      transform: scaleX(0.85) scaleY(1);
    }
    75% {
      transform: scaleX(0.9) scaleY(1);
    }
    90% {
      transform: scaleX(1.85) scaleY(0.95);
    }
    100% {
      transform: scaleX(1) scaleY(1);
    }
  }

  .p-presentation {
    padding: 12px 0;
    font-size: 19px;
    width: 90%;
    text-align: left;
  }

  .container-photo-profile {
    position: relative;
    width: 50%;
    display: flex;
    justify-content: center;
  }

  .photo-perfil {
  position: relative;
  display: flex;
  justify-content: center;
  overflow: hidden;
  height: 300px;
  width: 300px;
  margin-top: 30px;
  margin-left: 110px;
  border-radius: 50%;
  z-index: 10;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(4px);
  border: 2px solid rgba(168, 85, 247, 0.4);
  transition: all 0.6s ease;
}

.photo-perfil img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.photo-perfil:hover img {
  transform: scale(1.12);
}

   {
    /* responsive*/
  }
  @media (max-width: 900px) {
    .container-persentation {
      flex-direction: column-reverse;
      height: auto;
      gap: 30px;
      padding-top: 100px;
    }
    .container-photo-profile {
      width: 100%;
      justify-content: center;
      justify-items: center;
      margin: 0;
    }
    .photo-perfil {
      margin: 0;
    }
    .container-text {
      width: 100%;
    }

    .text-name{
      text-align: center;
    }
  }

  @media (max-width: 640px) {
    .p-presentation {
      width: 100%;
    }
  }

  @media (max-width: 500px) {
    .linear-gradient-1 {
      display: none;
    }
  }
</style>