---
import "../styles/style.css";
---

<section class="relative z-10 bg-[#0A111A] py-20 flex flex-col">
  <div
    class="absolute left-0 top-0 w-full h-full bg-black/10 backdrop-blur-[2px] z-0"
  >
  </div>
  <h2
    class="relative text-4xl font-black mb-6 text-white self-end pr-30 after:content-[''] after:absolute after:right-0 after:top-1/2 after:-translate-y-1/2 after:w-24 after:h-[3px] after:bg-[#E9D5FF]"
  >
    ارتباط با من
  </h2>
  <p id="contact" dir="rtl" class="text-[#7B7F86] mb-12 max-w-2xl mx-auto z-40">
    اگر پروژه‌ای دارید یا می‌خواهید درباره همکاری صحبت کنیم، خوشحال می‌شوم از
    شما بشنوم.
  </p>
  <div class="grid md:grid-cols-3 gap-8 px-10">
    <div
      class="card bg-[#23262F]/60 backdrop-blur-xl p-8 rounded-2xl border border-[#2f333d]
                hover:scale-105 hover:shadow-lg hover:shadow-[#A855F7]/30 transition duration-300"
    >
      <div
        class="w-14 h-14 bg-gradient-to-tr from-[#7C3AED] to-[#A855F7] rounded-xl
                  mb-6 flex items-center justify-center mx-auto shadow-md"
      >
        <svg fill="none" viewBox="0 0 24 24" stroke="white" class="w-7 h-7">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 
                   2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 
                   2 0 002 2z"
          ></path>
        </svg>
      </div>
      <div class="text-center">
        <div class="font-semibold text-white mb-2">ایمیل</div>
        <div class="text-[#9CA3AF]">VibelessYoung@gmail.com</div>
      </div>
    </div>
    <div
      class="card bg-[#23262F]/60 backdrop-blur-xl p-8 rounded-2xl border border-[#2f333d]
                hover:scale-105 hover:shadow-lg hover:shadow-[#A855F7]/30 transition duration-300"
    >
      <div
        class="w-14 h-14 bg-gradient-to-tr from-[#7C3AED] to-[#A855F7] rounded-xl
                  mb-6 flex items-center justify-center mx-auto shadow-md"
      >
        <svg fill="none" viewBox="0 0 24 24" stroke="white" class="w-7 h-7">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 
                   1.998 0 01-2.827 0l-4.244-4.243a8 8 
                   0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
      </div>
      <div class="text-center">
        <div class="font-semibold text-white mb-2">آدرس</div>
        <div class="text-[#9CA3AF]">ایران، مشهد</div>
      </div>
    </div>

    <div
      class="card bg-[#23262F]/60 backdrop-blur-xl p-8 rounded-2xl border border-[#2f333d]
                hover:scale-105 hover:shadow-lg hover:shadow-[#A855F7]/30 transition duration-300"
    >
      <div
        class="w-14 h-14 bg-gradient-to-tr from-[#7C3AED] to-[#A855F7] rounded-xl
                  mb-6 flex items-center justify-center mx-auto shadow-md"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-7 h-7 text-white"
        >
          <path
            d="M9.032 15.684l-.396 5.581c.566 0 .812-.244 1.106-.537l2.652-2.548 
           5.497 3.934c1.007.556 1.72.263 1.978-.93l3.587-16.835h.001c.318-1.49-.54-2.072-1.518-1.71L1.314 9.652c-1.444.556-1.422 1.353-.245 1.717l5.549 1.73 
           12.878-8.1c.607-.414 1.16-.185.705.229l-10.17 9.507z"
          ></path>
        </svg>
      </div>
      <div class="text-center">
        <div class="font-semibold text-white mb-2">تلگرام</div>
        <div class="text-[#9CA3AF]">@VibelessYoung</div>
      </div>
    </div>
  </div>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      ScrollReveal().reveal(".card", {
        duration: 1000,
        origin: "bottom",
        distance: "20px",
        easing: "ease-in-out",
        reset: false,
      });
    });
  </script>
</section>
