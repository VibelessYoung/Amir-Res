<script is:inline>
  const element = document.querySelector(".typing-effect");
  const texts = ["Programmer", "WebDesigner", "Front-End Developer"];
  let index = 0;
  let charIndex = 0;
  let deleting = false;
  function type() {
    const text = texts[index];
    if (deleting) {
      charIndex--;
    } else {
      charIndex++;
    }
    element.textContent = text.substring(0, charIndex);
    let speed = deleting ? 40 + Math.random() * 40 : 60 + Math.random() * 70;
    if (!deleting && charIndex === text.length) {
      deleting = true;
      speed = 1000;
    }
    if (deleting && charIndex === 0) {
      deleting = false;
      index = (index + 1) % texts.length;
      speed = 500;
    }
    setTimeout(type, speed);
  }
  type();
</script>
