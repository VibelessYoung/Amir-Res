---
import "../styles/style.css";
import "swiper/css";
import "swiper/css/navigation";
import "swiper/css/pagination";
import SwiperProjects from "./SwiperProjects.astro";
import ProjectsReveall from "./ProjectsReveall.astro";
---

<section id="projects" class="relative z-10 py-30 flex flex-col bg-[#0A111A]">
  <div
    class="absolute left-0 top-[1px] w-full h-full bg-gradient-to-b from-[#A855F7] to-[#0A111A] z-0"
  >
  </div>
  <div
    class="absolute left-0 top-0 w-full h-full bg-black/10 backdrop-blur-[2px] z-0"
  >
  </div>
  <h2
    class="relative text-4xl font-black mb-6 text-white self-end pr-30 after:content-[''] after:absolute after:right-0 after:top-1/2 after:-translate-y-1/2 after:w-24 after:h-[3px] after:bg-[#E9D5FF]"
  >
    پروژه ها
  </h2>
  <div class="flex w-full items-start">
    <div class="tick hidden lg:flex w-1/4 justify-center self-center z-50">
      <div dir="rtl" class="flex flex-col items-center justify-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-40 text-[#E9D5FF]"
        >
          <path
            fill-rule="evenodd"
            d="M8.603 3.799A4.49 4.49 0 0 1 12 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 0 1 3.498 1.307 4.491 4.491 0 0 1 1.307 3.497A4.49 4.49 0 0 1 21.75 12a4.49 4.49 0 0 1-1.549 3.397 4.491 4.491 0 0 1-1.307 3.497 4.491 4.491 0 0 1-3.497 1.307A4.49 4.49 0 0 1 12 21.75a4.49 4.49 0 0 1-3.397-1.549 4.49 4.49 0 0 1-3.498-1.306 4.491 4.491 0 0 1-1.307-3.498A4.49 4.49 0 0 1 2.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 0 1 1.307-3.497 4.49 4.49 0 0 1 3.497-1.307Zm7.007 6.387a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z"
            clip-rule="evenodd"></path>
        </svg>
        <strong class="text-center text-[#E9D5FF] text-2xl"
          >جهت مشاهده همه پروژه ها به گیت هاب مراجعه کنید.</strong
        >
      </div>
    </div>
    <div class="w-full mt-5 lg:w-3/4">
      <div class="sm:col-span-2 px-3 sm:px-0">
        <div class="swiper MySwiper rounded-2xl overflow-hidden w-full">
          <div class="swiper-wrapper">
            <div class="swiper-slide">
              <div
                class="h-auto flex flex-col gap-4 bg-[#1F242C] rounded-2xl shadow-2xl overflow-hidden group"
              >
                <img
                  src="/images/twitter.jpg"
                  alt="twitter"
                  class="w-full h-44 object-cover"
                  loading="lazy"
                />
                <h1 class="text-center text-gray-300 font-black text-2xl mt-3">
                  Twitter
                </h1>
                <p
                  dir="rtl"
                  class="text-center text-gray-300 text-sm mt-2 px-3"
                >
                  شبیه سازی سایت تویتر با ای پی آی همراه قابلیت لود دیتا و ارسال
                  نظر و فیلتر نظرات همراه هشتگ ها.
                </p>
                <a
                  href="https://twitter-web-clone-dusky.vercel.app/"
                  target="_blank"
                >
                  <button
                    class="cursor-pointer mb-3 flex items-center justify-center gap-2 px-4 py-2 mt-auto mx-auto bg-[#8B5CF6] hover:bg-purple-800 rounded-lg text-sm border-0 transition-colors"
                  >
                    مشاهده
                  </button></a
                >
              </div>
            </div>
            <div class="swiper-slide">
              <div
                class="h-auto flex flex-col gap-4 bg-[#1F242C] rounded-2xl shadow-2xl overflow-hidden group"
              >
                <img
                  src="/images/text.jpg"
                  alt="text"
                  class="w-full h-44 object-cover"
                  loading="lazy"
                />
                <h1 class="text-center text-gray-300 text-2xl font-black mt-3">
                  OCR-Extractor
                </h1>
                <p
                  dir="rtl"
                  class="text-center text-gray-300 text-sm mt-2 px-3"
                >
                  یک وبسایت ساده ولی مدرن برای آپلود تصاویر و استخراج متن از
                  آنها به سادگی.
                </p>
                <a
                  href="https://ocr-extractor-web-page.vercel.app/"
                  target="_blank"
                >
                  <button
                    class="cursor-pointer mb-3 flex items-center justify-center gap-2 px-4 py-2 mt-auto mx-auto bg-[#8B5CF6] hover:bg-purple-800 rounded-lg text-sm border-0 transition-colors"
                  >
                    مشاهده
                  </button></a
                >
              </div>
            </div>
            <div class="swiper-slide">
              <div
                class="h-auto flex flex-col gap-4 bg-[#1F242C] rounded-2xl shadow-2xl overflow-hidden group"
              >
                <img
                  src="/images/scarlet.jpg"
                  alt="scarlet-nexus"
                  class="w-full h-44 object-cover"
                  loading="lazy"
                />
                <h1 class="text-center text-gray-300 text-2xl font-black mt-3">
                  Saturn-Anime
                </h1>
                <p
                  dir="rtl"
                  class="text-center text-gray-300 text-sm mt-2 px-3"
                >
                  یک وبسایت انیمه که در آن با کمک ای پی آی انیمه ها لود و میتوان
                  اطلاعات آ نها رو دید.
                </p>
                <a href="https://saturn-anime.vercel.app/" target="_blank">
                  <button
                    class="cursor-pointer mb-3 flex items-center justify-center gap-2 px-4 py-2 mt-auto mx-auto bg-[#8B5CF6] hover:bg-purple-800 rounded-lg text-sm border-0 transition-colors"
                  >
                    مشاهده
                  </button></a
                >
              </div>
            </div>
            <div class="swiper-slide">
              <div
                class="h-auto flex flex-col gap-4 bg-[#1F242C] rounded-2xl shadow-2xl overflow-hidden group"
              >
                <img
                  src="/images/search.jpg"
                  alt="search"
                  class="w-full h-44 object-cover"
                  loading="lazy"
                />
                <h1 class="text-center text-gray-300 text-2xl font-black mt-3">
                  JobRemote
                </h1>
                <p
                  dir="rtl"
                  class="text-center text-gray-300 text-sm mt-2 px-3"
                >
                  یک وبسایت پیدا کردن شغل همراه ای پی آی که قابلیت های سرچ و. .
                  . داره.
                </p>
                <a
                  href="https://jobs-remot-web-page.vercel.app/"
                  target="_blank"
                >
                  <button
                    class="cursor-pointer mb-3 flex items-center justify-center gap-2 px-4 py-2 mt-auto mx-auto bg-[#8B5CF6] hover:bg-purple-800 rounded-lg text-sm border-0 transition-colors"
                  >
                    مشاهده
                  </button></a
                >
              </div>
            </div>
          </div>
          <div class="swiper-pagination"></div>
          <div class="swiper-button-next custom-swiper-btn cursor-pointer">
          </div>
          <div class="swiper-button-prev custom-swiper-btn cursor-pointer">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<ProjectsReveall client:visible />
<SwiperProjects client:visible />
